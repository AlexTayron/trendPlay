# ==============================================================================
# TrendPlay / DevCore — Variáveis de Produção para VPS Hostinger
# Copie para `.env.prod` na VPS e preencha os valores reais:
#   cp .env.prod.example .env.prod
# ==============================================================================

# Subdomínio onde a plataforma ficará acessível (SEM https://)
APP_DOMAIN=cursos.seudominio.com

# Portas locais da VPS (apenas 127.0.0.1) — altere se já usar 3100 ou 4100
WEB_HOST_PORT=3100
API_HOST_PORT=4100

# Banco PostgreSQL (gere senhas fortes! Ex.: openssl rand -hex 20)
POSTGRES_DB=devcore
POSTGRES_USER=devcore_admin
POSTGRES_ADMIN_PASSWORD=troque_por_senha_admin_forte
DB_APP_PASSWORD=troque_por_senha_app_forte

# Google Cloud OAuth + Picker
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_PICKER_API_KEY=sua_api_key_AIza
GOOGLE_APP_ID=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly

# Opcional: YouTube Data API v3 (se vazio, usa o parser público automaticamente)
YOUTUBE_API_KEY=

# Chaves de segurança (OBRIGATÓRIO gerar novas em produção!)
# Rode na VPS: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=gere_64_caracteres_hex_com_openssl_rand_hex_32
JWT_SECRET=gere_uma_chave_longa_com_openssl_rand_hex_32
