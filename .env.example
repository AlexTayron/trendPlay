# ==============================================================================
# AMBIENTE & HOSPEDAGEM
# ==============================================================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# BANCO DE DADOS (PostgreSQL 16 + pgvector)
# ==============================================================================
# Porta publicada pelo docker-compose.
DEVCORE_DB_PORT=5433

# Role com permissões administrativas para migrações (dono do schema)
DATABASE_ADMIN_URL=postgresql://devcore_admin:devcore_secure_password_dev@localhost:5433/devcore

# Role restrita para runtime da API e Worker (sem superuser, sem BYPASSRLS)
DATABASE_APP_URL=postgresql://devcore_app:devcore_app_password_dev@localhost:5433/devcore

# ==============================================================================
# AUTENTICAÇÃO GOOGLE OAUTH 2.0 & GOOGLE DRIVE
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_PICKER_API_KEY=your_google_picker_api_key
# Project Number (opcional — se vazio, é extraído automaticamente do GOOGLE_CLIENT_ID)
GOOGLE_APP_ID=
# Escopo padrão conforme D5 (drive.file + Picker). Se quiser listar subpastas automaticamente sem selecionar arquivo por arquivo, use drive.readonly:
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# URL da API usada pelo frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000

# Chave mestra para Envelope Encryption (AES-256-GCM) dos tokens do Drive
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_devcore_2026_at_least_32_chars

# ==============================================================================
# MOTOR DE IA, EMBEDDINGS & RAG
# ==============================================================================
# Provedor de Embeddings (Fase 0 define o modelo canônico)
EMBEDDING_MODEL_VERSION=text-embedding-3-small-1536
EMBEDDING_API_KEY=your_embedding_api_key

# Provedor de Chat / Tutor LLM (Google Gemini recomendado)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
LLM_PROVIDER=gemini # gemini | openai | anthropic
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=your_llm_api_key

